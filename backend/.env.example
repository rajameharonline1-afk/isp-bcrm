# ফাইল: backend/.env.example
# এই ফাইলটি সব environment variable-এর template। .env নামে copy করে নিজের তথ্য দিন।

# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=isp_crm_db
DB_USER=isp_crm_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMS Gateway
SMS_GATEWAY_URL=https://your-sms-gateway.com/api
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=ISPCM

# Company Information
COMPANY_NAME=Your ISP Company Name
COMPANY_EMAIL=info@yourcompany.com
COMPANY_PHONE=+88017xxxxxxxx
COMPANY_ADDRESS=Your Company Address, Dhaka, Bangladesh

# Payment Gateway (SSL Commerz)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
SSLCOMMERZ_IS_SANDBOX=True

# FreeRADIUS Database Connection
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius_user
RADIUS_DB_PASSWORD=radius_password
RADIUS_DB_HOST=localhost
RADIUS_DB_PORT=5432

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Media & Static Files
MEDIA_ROOT=/var/www/isp-crm/media
STATIC_ROOT=/var/www/isp-crm/static
